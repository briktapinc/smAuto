# Stickman Automation — environment template (copy to .env; never commit secrets)
#
# Local vs production is selected by BUBBLEPOD_ENV / APP_ENV and PUBLIC_BASE_URL:
#   - production: set PUBLIC_BASE_URL to the public HTTPS domain (no port)
#   - local: leave PUBLIC_BASE_URL unset (derived as http://HOST:PORT) OR set it explicitly

# production | local | development
BUBBLEPOD_ENV=local
# APP_ENV=local

# Listen bind (Studio / uvicorn). Defaults: 127.0.0.1 and 7878. Port is overridable.
BUBBLEPOD_HOST=127.0.0.1
BUBBLEPOD_PORT=7878
# Aliases also accepted: HOST, PORT, LAZYKH_HOST, LAZYKH_PORT

# --- Local ---
# Leave PUBLIC_BASE_URL empty to use http://127.0.0.1:${BUBBLEPOD_PORT}
# Or set explicitly (example with default port):
# PUBLIC_BASE_URL=http://127.0.0.1:7878

# --- Production (this VPS) ---
# BUBBLEPOD_ENV=production
# PUBLIC_BASE_URL=https://stickmanautomation.com
# Aliases: BUBBLEPOD_PUBLIC_BASE_URL, LAZYKH_PUBLIC_BASE_URL

# Optional: comma-separated CORS origins (defaults include local host:port + PUBLIC_BASE_URL)
# BUBBLEPOD_CORS_ORIGINS=https://stickmanautomation.com,http://127.0.0.1:7878

# --- ngrok (optional reserved-domain tunnel; not required when PUBLIC_BASE_URL is already public) ---
# Install: https://ngrok.com/download (Linux amd64 binary on PATH, e.g. /usr/local/bin/ngrok)
# Or set an absolute path:
# NGROK_PATH=/usr/local/bin/ngrok
# Agent authtoken (required to start a tunnel) — get from https://dashboard.ngrok.com/get-started/your-authtoken
# Do not invent a token; leave unset until you have one. Without it Studio reports "authtoken missing".
# NGROK_AUTHTOKEN=

# Optional secrets (prefer Admin UI / user_data/settings.json for local)
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# EMAIL_ENABLED=0
